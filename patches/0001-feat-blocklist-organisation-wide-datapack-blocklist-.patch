@@ -0,0 +1,174 @@
+# .github/workflows/datapack-blocklist-sync.yml
+#
+# Keeps the organisation-wide datapack blocklist in step with vortaforge/core
+# and profile-scans accounts that touch the organisation.
+#
+# Trust boundary:
+#   * read-only on this repository except for the one commit step, which runs
+#     with the default GITHUB_TOKEN and only ever writes blocklist/blocklist.json
+#     and generated/*.json;
+#   * the profile scan reads PUBLIC profile fields only (bio, company, name,
+#     blog) for accounts that already appear in a PR/issue or an invitation -
+#     never private data, never a global GitHub search, never scraping;
+#   * a hit never blocks anyone automatically: it opens an issue that a human
+#     resolves. Until then pull requests from that account are refused
+#     (fail-closed) by the guard in vortaforge/core.
+#
+# Requires no secrets beyond the default token. Actions are pinned by SHA, as
+# the maintainer guide requires (the same rule the core repository enforces).
+name: Datapack blocklist sync
+
+on:
+  workflow_dispatch:
+  schedule:
+    # Daily. Cheap: one raw file, at most a handful of profile lookups.
+    - cron: "17 5 * * *"
+  push:
+    branches: [main]
+    paths:
+      - "scripts/blocklist_sync.py"
+      - "blocklist/**"
+      - ".github/workflows/datapack-blocklist-sync.yml"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: datapack-blocklist-sync
+  cancel-in-progress: false
+
+jobs:
+  sync:
+    name: Mirror core blocklist and scan profiles
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+
+    permissions:
+      contents: write      # only to commit the generated mirror
+      issues: write        # only to open a profile-scan issue
+      pull-requests: read  # to list recent PR authors for the profile scan
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          fetch-depth: 0
+
+      - name: Set up Python 3.12
+        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7
+        with:
+          python-version: "3.12"
+
+      - name: Check for drift against vortaforge/core
+        id: drift
+        shell: bash
+        run: |
+          set -euo pipefail
+          if python3 scripts/blocklist_sync.py --check --fetch; then
+            echo "mirror_up_to_date=1" >> "$GITHUB_OUTPUT"
+          else
+            echo "mirror_up_to_date=0" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Regenerate the mirror
+        if: steps.drift.outputs.mirror_up_to_date != '1'
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 scripts/blocklist_sync.py --write --fetch
+
+      - name: Commit the mirror
+        if: steps.drift.outputs.mirror_up_to_date != '1'
+        shell: bash
+        run: |
+          set -euo pipefail
+          if git diff --quiet -- blocklist generated; then
+            echo "nothing to commit"
+            exit 0
+          fi
+          git config user.name "vortaforge-maintenance"
+          git config user.email "actions@vortaforge.local"
+          git add blocklist/blocklist.json generated/blocklist.json
+          git commit -m "chore(blocklist): mirror vortaforge/core blocklist [skip ci]"
+          git push
+
+      - name: Collect accounts to profile-scan
+        shell: bash
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          # Only accounts that already interacted with this repository:
+          # recent PR authors and issue authors, plus anyone invited recently.
+          # Never a global search.
+          : > /tmp/logins.txt
+          gh pr list --repo "${{ github.repository }}" --state all --limit 50 \
+            --json author --jq '.[].author.login' >> /tmp/logins.txt || true
+          gh issue list --repo "${{ github.repository }}" --state all --limit 50 \
+            --json author --jq '.[].author.login' >> /tmp/logins.txt || true
+          sort -u /tmp/logins.txt -o /tmp/logins.txt
+          echo "accounts to scan: $(wc -l < /tmp/logins.txt)"
+
+      - name: Profile scan (public fields only)
+        id: scan
+        shell: bash
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          if [ ! -s /tmp/logins.txt ]; then
+            echo "no accounts to scan"
+            exit 0
+          fi
+          if python3 scripts/blocklist_sync.py --scan-profiles --logins-file /tmp/logins.txt; then
+            echo "hits=0" >> "$GITHUB_OUTPUT"
+          else
+            echo "hits=1" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Open an issue for unresolved profile hits
+        if: steps.scan.outputs.hits == '1'
+        shell: bash
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          title="Datapack profile scan: unresolved hits $(date -u +%F)"
+          body="$(python3 - <<'PY'
+          import json
+          report = json.load(open("generated/profile-scan.json"))
+          lines = ["The public-profile scan matched accounts that look like datapack developers.",
+                   "", "Policy: datapack developers are blocked organisation-wide",
+                   "(maintainer decision 2026-11-05). Resolve each account below by either",
+                   "adding it to `blocked` in vortaforge/core's `blocklist/blocklist.json` or",
+                   "exempting it in `managed.accounts`.", "",
+                   "| Account | Verdict | Matched tokens |", "|---|---|---|"]
+          for result in report["results"]:
+              if result["verdict"] in ("hit", "unknown"):
+                  lines.append(f"| @{result['login']} | {result['verdict']} | "
+                               f"{', '.join(result['matched_tokens']) or '-'} |")
+          lines += ["", "Until this is resolved the account's pull requests are refused",
+                    "(fail-closed). Only public profile fields were read; no private data",
+                    "and no credentials are included in this report."]
+          print("\n".join(lines))
+          PY
+          )"
+          if gh issue list --repo "${{ github.repository }}" --state open \
+               --search "Datapack profile scan in:title" --json number --jq '.[].number' \
+               | grep -q .; then
+            echo "an open scan issue already exists; updating instead of duplicating"
+            number="$(gh issue list --repo "${{ github.repository }}" --state open \
+              --search "Datapack profile scan in:title" --json number --jq '.[0].number')"
+            gh issue comment "$number" --repo "${{ github.repository }}" --body "$body"
+          else
+            gh issue create --repo "${{ github.repository }}" --title "$title" --body "$body"
+          fi
+
+      - name: Upload scan report
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
+        with:
+          name: blocklist-sync-report
+          path: generated/
+          if-no-files-found: ignore
+          retention-days: 30
